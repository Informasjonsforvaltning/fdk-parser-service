{
  "type": "record",
  "name": "Standard",
  "namespace": "no.digdir.fdk.model",
  "doc": "Standard (dct:Standard) with one or more links",
  "fields": [
    {
      "name": "uri",
      "type": [
        "string",
        "null"
      ],
